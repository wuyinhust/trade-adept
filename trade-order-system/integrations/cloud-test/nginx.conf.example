# Add only to an existing Nginx installation with this dedicated test hostname.
# Replace the example hostname and install its matching certificate beforehand.
server {
    listen 443 ssl;
    server_name tradept-test.example.com;

    ssl_certificate /etc/ssl/tradept-test/fullchain.pem;
    ssl_certificate_key /etc/ssl/tradept-test/privkey.pem;

    # The API accepts JSON bodies up to 5 MiB. Permit HTTP framing overhead.
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:3087;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
